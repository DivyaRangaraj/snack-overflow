// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Category {
  SWEET
  SAVOURY
  DRINK
  HEALTHY_ISH
}

enum ActionType {
  CONSUMED
  RESTOCKED
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  password   String
  role       Role       @default(MEMBER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  votes      Vote[]
  activities Activity[]

  @@index([email])
}

model Snack {
  id                String     @id @default(cuid())
  name              String     @unique
  category          Category
  quantity          Int        @default(0)
  lowStockThreshold Int        @default(5)
  imageUrl          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  votes             Vote[]
  activities        Activity[]

  @@index([category])
  @@index([quantity])
  @@index([name])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  snackId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snack     Snack    @relation(fields: [snackId], references: [id], onDelete: Cascade)

  @@unique([userId, snackId])
  @@index([snackId])
  @@index([userId])
  @@index([createdAt])
}

model Activity {
  id        String     @id @default(cuid())
  userId    String
  snackId   String
  action    ActionType
  amount    Int
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  snack     Snack      @relation(fields: [snackId], references: [id], onDelete: Cascade)

  @@index([snackId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
