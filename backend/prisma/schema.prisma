// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Category {
  SWEET
  SAVOURY
  DRINK
  HEALTHY_ISH
}

enum ActionType {
  CONSUMED
  RESTOCKED
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum NotificationType {
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_DECLINED
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  password         String
  role             Role           @default(MEMBER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  votes            Vote[]
  activities       Activity[]
  requests         SnackRequest[] @relation("UserRequests")
  reviewedRequests SnackRequest[] @relation("AdminReviewedRequests")
  notifications    Notification[]

  @@index([email])
}

model Snack {
  id                String     @id @default(cuid())
  name              String     @unique
  category          Category
  quantity          Int        @default(0)
  lowStockThreshold Int        @default(5)
  imageUrl          String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  votes             Vote[]
  activities        Activity[]

  @@index([category])
  @@index([quantity])
  @@index([name])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  snackId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snack     Snack    @relation(fields: [snackId], references: [id], onDelete: Cascade)

  @@unique([userId, snackId])
  @@index([snackId])
  @@index([userId])
  @@index([createdAt])
}

model Activity {
  id        String     @id @default(cuid())
  userId    String
  snackId   String
  action    ActionType
  amount    Int
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  snack     Snack      @relation(fields: [snackId], references: [id], onDelete: Cascade)

  @@index([snackId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model SnackRequest {
  id            String         @id @default(cuid())
  userId        String
  snackName     String
  category      Category
  reason        String?
  status        RequestStatus  @default(PENDING)
  adminId       String?
  adminResponse String?
  createdAt     DateTime       @default(now())
  reviewedAt    DateTime?

  user          User           @relation("UserRequests", fields: [userId], references: [id], onDelete: Cascade)
  admin         User?          @relation("AdminReviewedRequests", fields: [adminId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  requestId String?
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   SnackRequest?    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}
